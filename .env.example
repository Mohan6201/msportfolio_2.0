# =============================================================================
# MS Portfolio 2.0 — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.
# For production, set these via: vercel env add <KEY> production
# =============================================================================


# ── 1. Contact Form ──────────────────────────────────────────────────────────
# EmailJS dashboard: https://dashboard.emailjs.com

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=


# ── 2. AI / LLM ──────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey  (free: 1500 req/day)
# MUST use this exact variable name — @ai-sdk/google reads it automatically.

GOOGLE_GENERATIVE_AI_API_KEY=


# ── 3. Database (Turso / LibSQL) ─────────────────────────────────────────────
# Local dev  → DATABASE_URL=file:./portfolio.db  (leave TURSO_AUTH_TOKEN blank)
# Production → libsql://<db-name>.<org>.turso.io  +  TURSO_AUTH_TOKEN=<token>
#
# CLI: turso db create <name>
#      turso db show <name> --url
#      turso db tokens create <name>

DATABASE_URL=file:./portfolio.db
TURSO_AUTH_TOKEN=


# ── 4. Authentication (Better Auth) ──────────────────────────────────────────
# Generate secret: openssl rand -base64 32
# BETTER_AUTH_URL = your app's public origin (http://localhost:3000 for local dev)

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000


# ── 5. Admin Dashboard ───────────────────────────────────────────────────────
# Legacy API secret for /api/admin routes. Use a strong random string in prod.
# Generate: openssl rand -hex 24

ADMIN_SECRET=


# ── 6. File Storage (Vercel Blob) ────────────────────────────────────────────
# Required for KT Centre PDF uploads.
# Create store: vercel blob create-store <name> --access public --yes --environment production
# Token is auto-added to Vercel env vars and pulled via `vercel env pull`.

BLOB_READ_WRITE_TOKEN=


# ── 7. Cron Job Security ─────────────────────────────────────────────────────
# Protects /api/cron/* endpoints. Any strong random string.
# Generate: openssl rand -hex 32

CRON_SECRET=


# ── 8. GitHub API (optional) ─────────────────────────────────────────────────
# Raises rate limit from 60 → 5000 req/hr for GitHub stats widgets.
# Create at: https://github.com/settings/tokens  (classic, read-only, public_repo)

GITHUB_TOKEN=


# ── 9. Job Ingestion — Adzuna (optional) ─────────────────────────────────────
# Primary job feed. Powers /api/cron/ingest-jobs.
# Register at: https://developer.adzuna.com → My Apps → Create App

ADZUNA_APP_ID=
ADZUNA_API_KEY=


# ── 10. Job Ingestion — JSearch via RapidAPI (optional) ──────────────────────
# Secondary/fallback job feed.
# Subscribe at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch

JSEARCH_API_KEY=
