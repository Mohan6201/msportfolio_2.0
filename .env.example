# EmailJS (contact form — https://emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Google Gemini — used by @ai-sdk/google (MUST be this exact name)
# Get key at: https://aistudio.google.com/apikey (free tier: 1500 req/day)
GOOGLE_GENERATIVE_AI_API_KEY=

# GitHub (optional — raises API rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Database
# Local dev:    DATABASE_URL=file:./portfolio.db   (no TURSO_AUTH_TOKEN needed)
# Production:   DATABASE_URL=libsql://<name>.turso.io  +  TURSO_AUTH_TOKEN=<token>
DATABASE_URL=file:./portfolio.db
TURSO_AUTH_TOKEN=

# Better Auth
# Generate secret: openssl rand -base64 32  (or any 32+ char random string)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Admin dashboard legacy secret
ADMIN_SECRET=change_me_in_production

# Vercel Blob (for KT Centre PDF uploads — https://vercel.com/docs/storage/vercel-blob)
BLOB_READ_WRITE_TOKEN=

# Job ingestion (Adzuna primary — https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Job ingestion (JSearch secondary — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JSEARCH_API_KEY=

# Cron endpoint protection (any random string — sent as Authorization: Bearer <secret>)
CRON_SECRET=
