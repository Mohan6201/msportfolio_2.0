# =============================================================================
# MS Portfolio 2.0 — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is gitignored.
#
# For production env vars → Vercel Dashboard → Project → Settings → Env Vars
# =============================================================================


# ── 1. Contact Form (EmailJS) ─────────────────────────────────────────────────
# Dashboard: https://dashboard.emailjs.com → Service → Templates → Account → API Keys

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key


# ── 2. AI / LLM (Google Gemini via AI Studio) ─────────────────────────────────
# Key source: https://aistudio.google.com/apikey  (free: 1500 req/day on Flash)
# @ai-sdk/google reads this variable name automatically — do not rename it.

GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key


# ── 3. Database (Turso / LibSQL) ──────────────────────────────────────────────
# Local dev: use a local SQLite file — no cloud connection needed.
# Production: get your Turso URL and token from https://turso.tech/app

DATABASE_URL=file:./portfolio.db
TURSO_AUTH_TOKEN=


# ── 4. Authentication (Better Auth) ───────────────────────────────────────────
# Generate a new secret: openssl rand -base64 32
# BETTER_AUTH_URL must match the origin the app runs on.

BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000


# ── 5. Google OAuth (optional — needed for "Continue with Google") ─────────────
# 1. Go to: https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorised redirect URI: https://your-domain.vercel.app/api/auth/callback/google
# 4. Paste Client ID and Client Secret below.

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret


# ── 6. Password Reset Emails (Resend) ─────────────────────────────────────────
# Free tier: 100 emails/day — https://resend.com → API Keys → Create
# If left blank, reset links are printed to the server console (dev only).

RESEND_API_KEY=re_your_resend_api_key


# ── 8. File Storage (Vercel Blob) ─────────────────────────────────────────────
# Create a blob store in Vercel Dashboard → Storage → Blob
# Token is auto-set as a Vercel env var when you connect the store.

BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here


# ── 9. Cron Job Security ──────────────────────────────────────────────────────
# Sent as: Authorization: Bearer <secret> on all /api/cron/* endpoints.
# Only matters in production. Generate: openssl rand -hex 32

CRON_SECRET=


# ── 10. GitHub API ────────────────────────────────────────────────────────────
# Raises GitHub API rate limit from 60 → 5000 req/hr for the stats widget.
# Create at: https://github.com/settings/tokens (classic, read-only, public_repo)

GITHUB_TOKEN=ghp_your_github_personal_access_token


# ── 11. Job Ingestion — Adzuna (optional) ─────────────────────────────────────
# Primary job feed. Powers /api/cron/ingest-jobs.
# Register at: https://developer.adzuna.com → My Apps → Create App
# Country codes: in=India, gb=UK, us=USA, au=Australia

ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key
ADZUNA_COUNTRY=in


# ── 12. Job Ingestion — JSearch via RapidAPI (optional) ───────────────────────
# Secondary/fallback job feed.
# Subscribe at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch

JSEARCH_API_KEY=your_jsearch_rapidapi_key
